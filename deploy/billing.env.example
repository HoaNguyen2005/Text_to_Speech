# Default OFF. Copy these keys to backend/.env for native Windows,
# deploy/backend.env for Docker, or the backend Environment on Render.
BILLING_ENABLED=false
BILLING_DEMO_PRICES=false
# SePay QR bank code (example: MBBank). No credentials go in VITE_* variables.
SEPAY_BANK_CODE=
# Exact gateway/bank_brand_name reported by SePay (example: MBBank).
SEPAY_BANK_GATEWAY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Generate at least 24 random characters. Match SePay's Webhook API Key.
SEPAY_WEBHOOK_SECRET=
# Optional: SePay User API token for the manual Verify button.
SEPAY_API_TOKEN=
