# Runtime Compose env_file (format: raw); not for the Windows terminals.
# Prefer: node backend/scripts/init_docker_local.js. Never commit the filled file.
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Reuse the existing tts_app database and credentials; password must be URL-encoded.
DATABASE_URL=postgresql://tts_app:REPLACE_WITH_APP_DB_PASSWORD@postgres:5432/tts_app
PG_SSL_CA_FILE=

# Public issuer stays equal to the issuer used by the browser.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=tts-local
KEYCLOAK_AUDIENCE=tts-backend
KEYCLOAK_SERVICE_CLIENT_ID=tts-admin-service
KEYCLOAK_SERVICE_CLIENT_SECRET=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENGINE_URL=http://engine:8000
BOOK_ARTIFACT_ROOT=/app/backend/data/book-audio
BOOK_ENGINE_SECRET=
PUBLIC_BACKEND_URL=http://localhost:3000
BOOK_ANALYSIS_CONCURRENCY=2
EDGE_TTS_PREFETCH_CONCURRENCY=3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_INPUT_TOKEN_BUDGET=24000
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_PRESIGN_EXPIRY=3600
