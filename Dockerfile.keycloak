FROM quay.io/keycloak/keycloak:26.1.0

WORKDIR /opt/keycloak

# Copy custom themes and realm definition
COPY keycloak/themes/text2speech /opt/keycloak/themes/text2speech
COPY keycloak/realm-export.json /opt/keycloak/data/import/tts-local-realm.json

ENV KC_DB=postgres
ENV KC_HTTP_ENABLED=true
ENV KC_PROXY_HEADERS=xforwarded
ENV KC_HOSTNAME_STRICT=false
ENV JAVA_OPTS="-Xms128m -Xmx350m -XX:MetaspaceSize=96M -XX:MaxMetaspaceSize=160m -XX:+ExitOnOutOfMemoryError"

EXPOSE 8080

ENTRYPOINT ["/opt/keycloak/bin/kc.sh", "start-dev", "--import-realm"]
