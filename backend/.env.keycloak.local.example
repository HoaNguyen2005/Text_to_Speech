# File thật được tạo bởi scripts/configure_keycloak_phase3.js và được Git bỏ qua.
KEYCLOAK_URL=http://localhost:8080
# Địa chỉ Backend/worker gọi nội bộ; bỏ trống dùng KEYCLOAK_URL.
# Compose: http://keycloak:8080. Issuer JWT vẫn được kiểm tra theo KEYCLOAK_URL public.
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=tts-local
KEYCLOAK_AUDIENCE=tts-backend
KEYCLOAK_SERVICE_CLIENT_ID=tts-admin-service
KEYCLOAK_SERVICE_CLIENT_SECRET=
