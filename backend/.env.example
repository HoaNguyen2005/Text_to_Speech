# Cổng chạy Backend Gateway
PORT=3000

# Chuỗi kết nối MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/tts_db

# API key của Google Gemini (dùng cho tính năng Tóm tắt sách)
GEMINI_API_KEY=

# (Tùy chọn) Tên mô hình Gemini, mặc định gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest

# ===== Cloudflare R2 (lưu trữ audio: giọng mẫu + audio kết quả) =====
# Account ID: trang R2 Overview của Cloudflare (khối bên phải)
R2_ACCOUNT_ID=
# Bucket đã tạo (vd: tts-audio-storage)
R2_BUCKET=tts-audio-storage
# Tạo tại R2 → "Manage R2 API Tokens" → Create API Token (quyền Object Read & Write,
# phạm vi chỉ bucket này) → điền Access Key ID và Secret
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# (Tùy chọn) Nếu bật Public Access / custom domain cho bucket, điền base URL
# (vd: https://cdn.tenmien.com) để dùng link vĩnh viễn thay vì presigned URL.
# Bỏ trống → hệ thống dùng presigned URL (bucket private, khuyến nghị).
R2_PUBLIC_BASE_URL=
# Thời hạn presigned URL (giây), mặc định 3600
R2_PRESIGN_EXPIRY=3600

# Phase 3: backend đọc backend/.env.keycloak.local (do configure_keycloak_phase3.js tạo).
# Khi deploy bằng biến môi trường: dùng các biến trong .env.keycloak.local.example.
# Không đưa KEYCLOAK_SERVICE_CLIENT_SECRET vào frontend.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1
