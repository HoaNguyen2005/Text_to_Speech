# Cổng chạy Backend Gateway
PORT=3000

# Database PostgreSQL cho ứng dụng; tách riêng database Keycloak.
# npm run db:init tạo backend/.env.postgres.local với mật khẩu ngẫu nhiên.
# Khi deploy, cung cấp DATABASE_URL bằng secret của môi trường.
DATABASE_URL=
# Chỉ cần cho công cụ đọc nguồn chuyển dữ liệu/backup MongoDB; runtime không dùng.
MONGODB_URI=
# SSL CA khi kết nối PostgreSQL cloud (không tắt kiểm tra chứng chỉ).
PG_SSL_CA_FILE=

# API key của Google Gemini (dùng cho tính năng Tóm tắt sách)
GEMINI_API_KEY=

# (Tùy chọn) Tên mô hình Gemini, mặc định gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest
# Giãn cách mọi RPC Gemini (kể cả countTokens), tối thiểu 1.000 ms.
GEMINI_MIN_INTERVAL_MS=4000
# Số lần tự lên lịch lại liên tiếp; tối đa 20 lần cộng dồn mỗi tác vụ.
GEMINI_MAX_AUTO_RETRIES=8
# Ngân sách chờ liên tục; tôn trọng retryDelay, không gọi sớm hơn thời điểm được yêu cầu.
GEMINI_RETRY_WINDOW_MINUTES=30
# Mặc định phân tích từng phần; có thể đặt 2, RPC vẫn đi qua bộ điều tiết chung.
BOOK_ANALYSIS_CONCURRENCY=1

# ===== Cloudflare R2 (lưu trữ audio: giọng mẫu + audio kết quả) =====
# Account ID: trang R2 Overview của Cloudflare (khối bên phải)
R2_ACCOUNT_ID=
# Bucket đã tạo (vd: tts-audio-storage)
R2_BUCKET=tts-audio-storage
# Tạo tại R2 → "Manage R2 API Tokens" → Create API Token (quyền Object Read & Write,
# phạm vi chỉ bucket này) → điền Access Key ID và Secret
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# (Tùy chọn) Nếu bật Public Access / custom domain cho bucket, điền base URL
# (vd: https://cdn.tenmien.com) để dùng link vĩnh viễn thay vì presigned URL.
# Bỏ trống → hệ thống dùng presigned URL (bucket private, khuyến nghị).
R2_PUBLIC_BASE_URL=
# Thời hạn presigned URL (giây), mặc định 3600
R2_PRESIGN_EXPIRY=3600

# Phase 3: backend đọc backend/.env.keycloak.local (do configure_keycloak_phase3.js tạo).
# Khi deploy bằng biến môi trường: dùng các biến trong .env.keycloak.local.example.
# Không đưa KEYCLOAK_SERVICE_CLIENT_SECRET vào frontend.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HOST=127.0.0.1

# Sách nói 10/20/30 phút: npm run books:init sinh .env.books.local riêng.
# Backend và worker phải truy cập cùng PostgreSQL và thư mục data/book-audio với Engine.
# ENGINE_URL dùng chung cho bài giảng và sách nói; nếu bỏ trống dùng BOOK_ENGINE_URL bên dưới.
# Trong Compose sau này dùng http://engine:8000; chạy thủ công vẫn dùng loopback.
ENGINE_URL=
BOOK_ENGINE_URL=http://127.0.0.1:8000
# Tùy chọn đường dẫn tuyệt đối; phải được mount cùng vị trí với Engine.
BOOK_ARTIFACT_ROOT=
# Khi dùng biến môi trường thay cho file local, đặt cùng khóa bí mật ở Backend/worker/Engine.
# BOOK_ENGINE_SECRET=
PUBLIC_BACKEND_URL=http://localhost:3000
# Optional TTS selector default. Old requests remain on their saved provider.
TTS_PROVIDER=edge
# New book requests only; persisted in checkpoints. Existing jobs retain 6000.
BOOK_ANALYSIS_CHUNK_CHARS=12000
# Edge-only rolling prefetch window (1 = sequential, 2–3 = overlap network I/O).
EDGE_TTS_PREFETCH_CONCURRENCY=3
# Application input budget; remote counting is only needed near this limit.
GEMINI_INPUT_TOKEN_BUDGET=24000
